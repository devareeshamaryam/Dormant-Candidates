LOXO_TOKEN=
LOXO_SLUG=ateca-consulting
RESPOND_API_TOKEN=
# Numeric respond.io channel ID of the WhatsApp Business channel
RESPOND_CHANNEL_ID=525893

# true = only print what would be sent. Set to false to send real WhatsApp messages.
DRY_RUN=true
MAX_PER_RUN=50
DELAY_BETWEEN_MESSAGES_SEC=10
# Wait between creating the respond.io contact and tagging/messaging it
CONTACT_DELAY_SEC=3

# Google Sheet that receives all dormant candidates (overwritten each run).
# Share the sheet with the service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1

# Local "sent but not logged in Loxo" list. On Cloud Run use a mounted bucket path, e.g. /state/sent.json
SENT_LOG_FILE=./sent.json

# Optional: comma-separated job ids to limit the run (e.g. for testing)
JOB_IDS=
